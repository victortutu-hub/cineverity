# CineVerity — Google Cloud / Gemini
# Copy values into your shell environment. Do NOT commit real secrets.

GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True

# Gemini model used by the controlled specialist-stage runners.
CINEVERITY_GEMINI_MODEL=gemini-3.5-flash

# Parallel Search API key (required only for Research retrieval).
PARALLEL_API_KEY=
