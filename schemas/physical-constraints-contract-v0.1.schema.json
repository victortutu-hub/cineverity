  "additionalProperties": false,
  "description": "Deterministic boundary between accepted evidence and downstream scene planning.",
  "properties": {
    "agent": {
      "const": "physical_constraints_agent",
      "title": "Agent",
      "type": "string"
    },
    "artistic_deviations": {
      "items": {
        "$ref": "#/$defs/ArtisticDeviation"
      },
      "title": "Artistic Deviations",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/PhysicalConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/PhysicalConstraint"
      },
      "title": "Constraints",
      "type": "array"
    },
    "contract_version": {
      "const": "0.1",
      "title": "Contract Version",
      "type": "string"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/PhysicalQuestionCoverage"
      },
      "title": "Coverage",
      "type": "array"
    },
    "input_scope": {
      "$ref": "#/$defs/PhysicalConstraintsScope"
    },
    "physical_summary": {
      "minLength": 1,
      "title": "Physical Summary",
      "type": "string"
    },
    "unresolved_constraints": {
      "items": {
        "$ref": "#/$defs/UnresolvedPhysicalConstraint"
      },
      "title": "Unresolved Constraints",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "agent",
    "input_scope",
    "constraints",
    "conflicts",
    "unresolved_constraints",
    "artistic_deviations",
    "coverage",
    "physical_summary"
