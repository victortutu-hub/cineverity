      "enum": [
        "explicitly_nonphysical",
        "artistic_amplification",
        "speculative_behavior"
      ],
      "title": "ArtisticDeviationType",
      "type": "string"
    },
    "PhysicalAssessmentStatus": {
      "description": "Physical assessment of a constraint, distinct from question coverage.",
      "enum": [
        "supported",
        "conditionally_supported",
        "conflicting",
        "unsupported",
        "indeterminate"
      ],
      "title": "PhysicalAssessmentStatus",
      "type": "string"
    },
    "PhysicalConflictResolutionStatus": {
      "enum": [
        "unresolved",
        "context_dependent",
        "artist_decision_required"
      ],
