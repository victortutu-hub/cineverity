      "type": "string"
    },
    "SceneValidationHookKind": {
      "enum": [
        "director_target_check",
        "physical_constraint_check",
        "artistic_deviation_disclosure_check",
        "unresolved_dependency_check",
        "physical_conflict_check"
      ],
